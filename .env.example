# ============================================================
# Degradation Watch - Environment Configuration
# ============================================================

# Toggle Mock Data for offline testing
NEXT_PUBLIC_USE_MOCKS=true

# 1. Supabase (Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Textbee SMS Gateway (Kenya / International SMS)
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=your_device_id
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# 3. Safaricom M-Pesa (Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# 4. Gemini Multimodal AI (Vision & Hazard Assessment)
GEMINI_API_KEY=your_gemini_api_key
