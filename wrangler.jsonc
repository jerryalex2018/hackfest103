{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "degradation-watch",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    "NEXT_PUBLIC_USE_MOCKS": "false"
  }
}
